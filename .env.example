SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=server-side-only
OLUNI_SECRET=generate-an-independent-random-secret-with-at-least-32-characters
NODE_ENV=production
PORT=8080

# Integração central (somente servidor; opcional até a chave ser provisionada)
OLUNI_AI_PROVIDER=gemini
OLUNI_AI_MODEL=gemini-2.5-flash
OLUNI_AI_API_KEY=
OLUNI_AI_ENABLED=true
# Pacote de execução no Railway para mensagens de voz
RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg
